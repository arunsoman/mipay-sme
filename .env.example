# Copy to .env and adjust before `docker compose up` (compose reads .env automatically).
# Defaults keep the existing sandbox values, so an empty .env behaves like before.

# Database password (POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=mipay

# Backend runtime environment: sandbox | uat  (production disables the simulation layer)
APP_ENVIRONMENT=sandbox

# JWT signing secret - MUST be overridden for anything beyond sandbox
APP_JWT_SECRET=sandbox-jwt-secret-change-me-in-production-0123456789
