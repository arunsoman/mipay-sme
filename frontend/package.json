{
  "name": "sme-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "widget:new": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts new",
    "widgets:gen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts gen",
    "widgets:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts check",
    "widgets:register": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts register",
    "workbench": "ng serve widget-workbench",
    "test:widgets": "ng test widget-workbench --watch=false",
    "test:layout": "playwright test -c e2e/playwright.config.ts",
    "widgets:endpoint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts endpoint",
    "widgets:contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts contract",
    "widgets:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts ui",
    "workbench:live": "WB_LIVE=1 ng serve widget-workbench -c live",
    "widgets:prompt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts prompt",
    "widgets:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../tools/widgets.ts apply"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "1.54.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "jsdom": "26.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "vitest": "3.2.4"
  }
}
