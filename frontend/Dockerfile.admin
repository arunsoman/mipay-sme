# admin portal build (Angular 20 workspace, second application) + static nginx serving on 4201
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npx ng build admin-portal

FROM nginx:1.27-alpine
COPY projects/admin-portal/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/admin-portal/browser /usr/share/nginx/html
