# Org portals (manufacturer / distributor / supplier): one codebase, one image
# per portal. Build with --build-arg PORTAL=manufacturer|distributor|supplier.
FROM node:22-alpine AS build
ARG PORTAL=manufacturer
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npx ng build ${PORTAL}-portal && mv dist/${PORTAL}-portal/browser /portal

FROM nginx:1.27-alpine
COPY projects/org-portal/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /portal /usr/share/nginx/html
